<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
  android:layout_width="match_parent" android:layout_height="match_parent"
  android:orientation="vertical" android:padding="20dp">
  <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Supabase Project URL" />
  <EditText android:id="@+id/etUrl" android:layout_width="match_parent" android:layout_height="wrap_content"
    android:hint="https://xxxx.supabase.co" android:inputType="textUri" />
  <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
    android:layout_marginTop="12dp" android:text="Anon public key (BUKAN service_role)" />
  <EditText android:id="@+id/etKey" android:layout_width="match_parent" android:layout_height="wrap_content"
    android:inputType="textPassword" />
  <Button android:id="@+id/btnSave" android:layout_width="match_parent" android:layout_height="wrap_content"
    android:layout_marginTop="16dp" android:text="Simpan" />
</LinearLayout>
