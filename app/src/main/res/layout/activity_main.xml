<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
  android:layout_width="match_parent" android:layout_height="match_parent">
  <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
    android:orientation="vertical" android:padding="20dp">
    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Nama perekam" />
    <EditText android:id="@+id/etName" android:layout_width="match_parent" android:layout_height="wrap_content"
      android:hint="Fahmi / Abid" android:inputType="textPersonName" />
    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
      android:layout_marginTop="12dp" android:text="Aktivitas (label)" />
    <Spinner android:id="@+id/spLabel" android:layout_width="match_parent" android:layout_height="48dp" />
    <Button android:id="@+id/btnStartStop" android:layout_width="match_parent" android:layout_height="80dp"
      android:layout_marginTop="16dp" android:text="START" android:textSize="24sp" />
    <TextView android:id="@+id/tvStatus" android:layout_width="match_parent" android:layout_height="wrap_content"
      android:layout_marginTop="16dp" android:textSize="18sp" android:text="Siap" />
    <TextView android:id="@+id/tvSync" android:layout_width="match_parent" android:layout_height="wrap_content"
      android:layout_marginTop="16dp" />
    <Button android:id="@+id/btnSync" android:layout_width="match_parent" android:layout_height="wrap_content"
      android:layout_marginTop="16dp" android:text="Kirim ulang sekarang" />
    <Button android:id="@+id/btnExport" android:layout_width="match_parent" android:layout_height="wrap_content"
      android:text="Ekspor sesi ke CSV" />
  </LinearLayout>
</ScrollView>
